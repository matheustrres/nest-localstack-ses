{
	"name": "nest-localstack-ses",
	"version": "1.0.0",
	"author": "Matheus Torres <matheustrres.rj@gmail.com>",
	"description": "",
	"private": true,
	"license": "MIT",
	"scripts": {
		"prebuild": "rm -rf dist",
		"build": "nest build -p ./tsconfig.build.json -c ./nest-cli.json -b swc",
		"postbuild": "find dist -name '*.spec.js' -o -name '__tests__' | xargs rm -rf",
		"format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
		"prestart": "npm run build",
		"start": "dotenv -e .env.dev -- nest start",
		"start:dev": "dotenv -e .env.dev -- nest start --watch",
		"start:debug": "dotenv -e .env.dev -- nest start --watch",
		"start:prod": "node --env-file=.env ./dist/main",
		"lint": "eslint \"{src,apps,libs,tests}/**/*.ts\" --fix"
	},
	"dependencies": {
		"@aws-sdk/client-ses": "^3.775.0",
		"@nestjs/common": "^10.0.0",
		"@nestjs/config": "^3.2.3",
		"@nestjs/core": "^10.0.0",
		"@nestjs/platform-express": "^10.0.0",
		"@nestjs/swagger": "^8.1.0",
		"@scalar/nestjs-api-reference": "^0.3.174",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.1",
		"nanoid": "github:ai/nanoid#v3",
		"reflect-metadata": "^0.2.0",
		"rxjs": "^7.8.1"
	},
	"devDependencies": {
		"@nestjs/cli": "^10.0.0",
		"@nestjs/schematics": "^10.0.0",
		"@nestjs/testing": "^10.0.0",
		"@swc/cli": "^0.3.14",
		"@swc/core": "^1.7.10",
		"@swc/helpers": "^0.5.8",
		"@swc/jest": "^0.2.36",
		"@tsconfig/node-lts": "^20.1.3",
		"@types/express": "^4.17.17",
		"@types/node": "^20.3.1",
		"@typescript-eslint/eslint-plugin": "^7.0.0",
		"@typescript-eslint/parser": "^7.0.0",
		"dotenv-cli": "^7.4.2",
		"eslint": "^8.42.0",
		"eslint-config-prettier": "^9.0.0",
		"eslint-plugin-import-helpers": "^1.3.1",
		"eslint-plugin-prettier": "^5.0.0",
		"prettier": "^3.0.0",
		"source-map-support": "^0.5.21",
		"ts-loader": "^9.4.3",
		"ts-node": "^10.9.1",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.1.3"
	}
}